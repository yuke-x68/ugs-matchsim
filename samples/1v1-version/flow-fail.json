{
  "queue": { "timeoutSeconds": 10, "maxPlayersPerTicket": 1 },
  "tickSeconds": 1,
  "tickets": [
    { "id": "A", "at": 0,   "customData": { "GameVersion": "1.2.0" } },
    { "id": "B", "at": 0.5, "customData": { "GameVersion": "1.1.0" } },
    { "id": "C", "at": 1,   "customData": { "GameVersion": "1.2.0" } },
    { "id": "D", "at": 2,   "customData": { "GameVersion": "1.1.0" } },
    { "id": "E", "at": 3,   "customData": { "GameVersion": "1.3.0" } }
  ],
  "expect": [
    { "name": "passes: A pairs with C", "together": ["A", "C"] },
    { "name": "fails: different versions never match", "together": ["A", "B"] },
    { "name": "fails: E has no partner", "matched": ["E"] }
  ]
}
