{
  "$schema": "https://ugs-config-schemas.unity3d.com/v1/matchmaker/matchmaker-queue.schema.json",
  "name": "duel",
  "enabled": true,
  "maxPlayersPerTicket": 1,
  "defaultPool": {
    "variants": [],
    "name": "default",
    "enabled": true,
    "timeoutSeconds": 10,
    "matchLogic": {
      "matchDefinition": {
        "teams": [
          {
            "name": "Main",
            "teamCount": { "min": 2, "max": 2, "relaxations": [] },
            "playerCount": { "min": 1, "max": 1, "relaxations": [] },
            "teamRules": []
          }
        ],
        "matchRules": [
          {
            "source": "Players.CustomData.GameVersion",
            "name": "GameVersionEquality",
            "type": "Equality",
            "reference": null,
            "overlap": 0.0,
            "enableRule": true,
            "not": false,
            "relaxations": []
          }
        ]
      },
      "name": "Default1v1",
      "backfillEnabled": false
    },
    "matchHosting": { "type": "MatchId" }
  },
  "filteredPools": []
}
